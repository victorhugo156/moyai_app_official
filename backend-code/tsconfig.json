{
  "compilerOptions": {
    "target": "es6",
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },

  "include": ["src", "src/db"],
  "ts-node": {
    "esm": true
  }
}
